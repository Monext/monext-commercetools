    "@types/jest": "29.5.14",
    "@types/node": "22.12.0",
    "@typescript-eslint/eslint-plugin": "8.31.0",
    "@typescript-eslint/parser": "8.31.0",
    "eslint": "9.25.1",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-jest": "28.11.0",
    "eslint-plugin-prettier": "5.2.6",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "^15.14.0",
    "jest": "29.7.0",
    "msw": "2.7.5",
    "node-fetch": "3.3.2",
    "nodemon": "3.1.9",
    "prettier": "3.5.3",

{
  "name": "payment-integration-monext",
  "version": "1.0.0",
  "description": "Payment integration with Monext",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "node_modules/.bin/nodemon -q dist/main.js",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\" && eslint --ext .ts src test",
    "lint:fix": "prettier --write \"**/**/*.{ts,js,json}\" && eslint --fix --ext .ts src test",
    "build": "rm -rf /dist && tsc",
    "dev": "ts-node src/main.ts",
